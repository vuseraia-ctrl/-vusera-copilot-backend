# Bu faylı ".env" adı ilə kopyalayın və öz açarlarınızı yazın.
# ".env.example" özü heç vaxt real açarlarla paylaşılmamalıdır.

# Supabase layihənizin ayarlarından (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Anthropic Console-dan (əvvəllər istifadə etdiyiniz açar)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Voyage AI-dan (embedding üçün, pulsuz qeydiyyat: voyageai.com)
VOYAGE_API_KEY=your-voyage-api-key

# API və owner qoruması
API_SECRET=generate-a-long-random-secret
OWNER_SECRET=generate-a-different-long-random-secret

# Google Workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Digər inteqrasiyalar
SLACK_BOT_TOKEN=
HUBSPOT_ACCESS_TOKEN=
MAKE_ROUTER_URL=

PORT=3000

# Growth Agency
ANTHROPIC_MODEL=claude-sonnet-4-6
GROWTH_DAILY_SEND_LIMIT=10
